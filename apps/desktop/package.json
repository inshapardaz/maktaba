{
  "name": "maktaba-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Maktaba (مکتبہ) — a local-first ebook library manager",
  "author": "Maktaba contributors",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "41.7.1",
    "electron-builder": "^26.15.7",
    "typescript": "~5.6.0"
  },
  "build": {
    "appId": "com.inshapardaz.maktaba",
    "productName": "Maktaba",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "splash/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "afterPack": "electron-builder/afterPack.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "resources/backend/win-x64",
          "to": "backend"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "resources/backend/osx-${arch}",
          "to": "backend"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "extraResources": [
        {
          "from": "resources/backend/linux-x64",
          "to": "backend"
        }
      ]
    }
  }
}
